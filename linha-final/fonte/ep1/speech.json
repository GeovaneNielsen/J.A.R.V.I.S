"t0": 0.35,
"t1": 1.8,
"label": "KAUÃ",
"text": "Galera, isso aqui tá surreal!"
},
{
"file": "kaua_b",
"who": "kaua",
"t0": 3.3,
"t1": 5.32,
"label": "KAUÃ",
"text": "Seu Valdir, tem um cara mordendo o retrovisor!"
},
{
"file": "valdir_a",
"who": "valdir",
"t0": 5.8,
"t1": 7.0,
"label": "SEU VALDIR",
"text": "Fora do ponto ninguém sobe."
},
{
"file": "cida_a",
"who": "cida",
"t0": 9.2,
"t1": 12.05,
"label": "DONA CIDA",
"text": "Boa noite, motorista. Aceita um bolinho?"
},
{
"file": "rex",
"who": "rex",
"t0": 12.5,
"t1": 12.79,
"label": "REX",
"text": "Au! Au!"
},
{
"file": "otavio_a",
"who": "otavio",
"t0": 14.6,
"t1": 17.05,
"label": "PROFESSOR OTÁVIO",
"text": "Tecnicamente, aquilo lá fora são cadáveres andando."
},
{
"file": "cida_b",
"who": "cida",
"t0": 17.6,
"t1": 18.93,
"label": "DONA CIDA",
"text": "Come que passa."
},
{
