"who": "je",
"t0": 23.6,
"t1": 25.06,
"label": "JÉ",
"text": "Cinco estrelas pra mim, hein?"
},
{
"file": "valdir_b",
"who": "valdir",
"t0": 30.4,
"t1": 31.26,
"label": "SEU VALDIR",
"text": "Cartão ou dinheiro?"
},
{
"file": "valdir_c",
"who": "valdir",
"t0": 33.8,
"t1": 35.53,
"label": "SEU VALDIR",
"text": "Aqui é linha, não é academia."
},
{
"file": "kaua_c",
"who": "kaua",
"t0": 40.4,
"t1": 41.35,
"label": "KAUÃ",
"text": "Desde quando ele tá aí?"
},
{
"file": "valdir_d",
"who": "valdir",
"t0": 43.0,
"t1": 45.76,
"label": "SEU VALDIR",
"text": "Temos diesel pra uma parada. Ou o posto, ou o terminal."
},
{
"file": "je_b",
"who": "je",
"t0": 46.3,
"t1": 47.57,
"label": "JÉ",
"text": "No posto tem tomada."
},
{
"file": "kaua_d",
"who": "kaua",
"t0": 48.2,
"t1": 48.59,
"label": "KAUÃ",
"text": "TOMADA?!"
},
{
"file": "kaua_e",
"who": "kaua",
"t0": 51.8,
"t1": 53.87,
"label": "KAUÃ",
"text": "Vocês decidem. Mas comenta baixo."
},
{
"file": "rex",
"who": "rex",
"t0": 54.6,
"t1": 54.89,
"label": "REX",
"text": "Au! Au!"
